      "comment" : "Speak tab: alert message under 'Recording Error' when microphone permission is denied."
    },
    "DailyVox sends one gentle notification each day at your chosen time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
