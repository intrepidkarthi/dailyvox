    "It lives on your phone — nowhere else.\nSpeak again tomorrow, and your sky grows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es lebt auf deinem Telefon – sonst nirgends.\nSprich morgen wieder, und dein Himmel wächst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive en tu teléfono, en ningún otro sitio.\nHabla otra vez mañana y tu cielo crecerá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vit sur ton téléphone — nulle part ailleurs.\nParle à nouveau demain, et ton ciel s'agrandit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive sul tuo telefono, da nessun'altra parte.\nParla di nuovo domani e il tuo cielo crescerà."
          }
        }
      }
    },
