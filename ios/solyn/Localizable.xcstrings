          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lldh%2$@"
          }
        }
      }
    },
    "%lldpm" : {
      "comment" : "Stats > Your Week, Decoded: an afternoon or evening hour, used in 'Happiest entries at <hour>.' The placeholder is the hour on the 12-hour clock, 1 to 11 ('11pm' is 23:00). Use the local way of writing a time of day; 24-hour languages need the hour plus 12.\nTwin tab > When You Write: an afternoon or evening hour, inside 'Peak writing time: 9pm'. The placeholder is the hour on a 12-hour clock, 1-11. About 6 characters."
    },
    "%lld%%" : {
      "comment" : "A whole-number percentage, as in '72%'. Use the locale's percent style (space, sign position).\nStats > Your Week, Decoded: small stat chip on the insight card (also drawn into a shared image). About 20 characters. A percentage from 60 to 100.",
      "shouldTranslate" : false
    },
    "%lldx" : {
      "comment" : "Audio player: playback speed on the speed button, as in '1x' or '2x'. Keep it very short.\nStats > Your Week, Decoded: a whole-number multiplier ('3x'), used inside 'You write <multiplier> more when you're <mood>.' Keep it very short.\nStats > Your Week, Decoded: small stat chip on the insight card (also drawn into a shared image). About 20 characters. How many times a person was mentioned this week, as a multiplier ('8x'). Keep it very short.\nTwin tab > My World: how many times a person or place was mentioned, as in '12x'. The placeholder is the count. About 5 characters.",
      "shouldTranslate" : false
    },
    "0 BYTES" : {
