        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Gemello non lascia mai il tuo dispositivo"
          }
        }
      }
    },
    "YOUR TWIN NOTICED ✦" : {
      "comment" : "A title for a section of the StatsView.",
      "isCommentAutoGenerated" : true
    },
    "Your Twin sharpens with every entry. Come back after journaling to watch this climb." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Twin wird mit jedem Eintrag schärfer. Komm nach dem Schreiben zurück und sieh zu, wie er steigt."
          }
        },
        "es" : {
