    "Apple Intelligence is still preparing the on-device model — DailyVox switches automatically when it's ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence bereitet das Modell auf dem Gerät noch vor – DailyVox wechselt automatisch, sobald es bereit ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence aún está preparando el modelo en el dispositivo. DailyVox cambiará automáticamente cuando esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
