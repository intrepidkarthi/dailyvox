    "Before noon you write %@; after six, %@. %@ entries and %@." : {
      "comment" : "Twin tab, Patterns: smaller line under the finding, giving the numbers behind it. Mood scores run from -1 to +1 and arrive already formatted for the locale with a sign ('+0.21'). About 90 characters. 'after six' means after 18:00. First placeholder: the morning average. Second: the evening average. Third and fourth (string placeholders): how many morning and evening entries. Counts marked as string placeholders arrive as digits, exactly as the English has always printed them (never grouped), so the catalog cannot vary them by count: phrase it so one form reads right for every count.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vor Mittag schreibst du %1$@, nach sechs %2$@. %3$@ Einträge und %4$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before noon you write %1$@; after six, %2$@. %3$@ entries and %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antes del mediodía escribes %1$@; después de las seis, %2$@. Entradas: %3$@ y %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avant midi, tu écris à %1$@ ; après 18 h, à %2$@. Entrées : %3$@ et %4$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prima di mezzogiorno scrivi %1$@; dopo le 18, %2$@. Voci: %3$@ al mattino, %4$@ la sera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antes do meio-dia você escreve %1$@; depois das seis, %2$@. Registros: %3$@ e %4$@."
          }
        }
      }
    },
    "Body Twin is off — tap to review or let go of what's still waiting." : {
      "comment" : "Twin tab, Body Twin card: status line under the card title. About 60 characters. Body Twin is switched off but Health signals still wait for a decision. 'Let go' matches the button name in the review sheet.",
