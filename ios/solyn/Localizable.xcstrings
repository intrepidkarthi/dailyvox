    "Sleep" : {
      "comment" : "Body Twin invite sheet: name of a Health signal the Twin can read. One or two words, about 16 characters.\nSettings > Health: name of a signal Body Twin can read. One word, about 16 characters.\nShare card image (Body), drawn on a 1080px square and posted publicly. Row label, left column, when health data is off. About 18 characters."
    },
    "Sleep barely moved" : {
      "comment" : "Share card image (Body), drawn on a 1080px square and posted publicly. Headline, line 1 of 2: 'Sleep barely moved / how you wrote.' About 18 characters per line."
    },
    "Sleep hours and mood. Never heart rate." : {
      "comment" : "Share sheet: line under 'Include how you slept' while it is on. The privacy claim must stay exact. About 40 characters."
    },
    "Sleep, steps, quiet minutes — you approve every signal first." : {
      "comment" : "Body Twin invite card on the Today tab: line under the title. About 60 characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf, Schritte, ruhige Minuten – du gibst jedes Signal zuerst frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sueño, pasos, minutos de calma: tú apruebas cada señal antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommeil, pas, minutes de calme — tu approuves chaque signal d'abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonno, passi, minuti di calma: sei tu ad approvare prima ogni segnale."
          }
        }
      }
    },
    "Slept, on average" : {
      "comment" : "Share card image (Body), drawn on a 1080px square and posted publicly. Row label, left column; the value is hours and minutes such as 7h05. About 18 characters."
    },
    "Soft & Indirect" : {
      "comment" : "Personality card (Twin tab and the shared image): the communication-style badge. Describes the user: keep it gender-neutral. About 22 characters."
    },
    "Some days the body speaks first — short sleep, a long walk, a quiet morning. Connect Health and your Twin can hear that side of you too." : {
      "comment" : "Body Twin invite sheet: intro under the title. 'Health' is Apple's Health app. About 135 characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manchmal spricht der Körper zuerst – wenig Schlaf, ein langer Spaziergang, ein stiller Morgen. Verbinde Health, und dein Twin hört auch diese Seite von dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos días el cuerpo habla primero: poco sueño, una caminata larga, una mañana tranquila. Conecta Salud y tu Gemelo también podrá escuchar ese lado de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains jours, le corps parle en premier — peu de sommeil, une longue marche, une matinée calme. Connecte Santé et ton Jumeau pourra entendre cette part de toi aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certi giorni è il corpo a parlare per primo: poco sonno, una lunga camminata, una mattina tranquilla. Collega Salute e il tuo Gemello potrà ascoltare anche quel lato di te."
          }
        }
      }
    },
    "Sounds %@ — tap to change" : {
      "comment" : "Mood chip on Today and onboarding: a mood suggested from the entry's words. %@ is the mood, lowercased (e.g. calm)."
    },
    "SOUNDS %@?" : {
      "comment" : "Entry detail header: a suggested mood, in the mono caps style. %@ is the mood name in caps."
    },
    "Speak" : {
      "comment" : "Tab bar: the recording tab. One short word; four tabs share the bar, about 8 characters."
    },
    "Speak an entry on the Speak tab. 42 seconds is the sweet spot — take as long as you need." : {
      "comment" : "Twin tab, first run (no entries yet): step 1 of the four-step 'how it works' list. 'Speak' is the tab name. 42 seconds is a soft target, never a limit: keep 42 literal, never 'at least' or 'maximum'."
    },
    "Speak to plant your first star" : {
      "comment" : "Twin tab: line under the sky with no entries yet. About 35 characters."
    },
    "SPEAK TAB, THE GREEN MIC" : {
      "comment" : "Journal tab, empty state: pointer to where entries are made. Upper case, monospaced. 'Speak' is the tab's name; use the same word as the tab bar. About 24 characters."
    },
    "SUBSCRIPTION" : {
      "comment" : "Share card image (Receipt), drawn on a 1080px square and posted publicly. Receipt line label, left column. Upper case, monospaced, about 20 characters."
    },
    "Sad" : {
      "comment" : "Mood name. Shown alone (picker chip, stats row) and lower-cased inside sentences such as 'Feeling sad'. An adjective about the user: keep it gender-neutral. About 10 characters."
    },
    "Speak your thoughts. Every word becomes a star in your inner sky. All AI runs on your device — private by design." : {
      "comment" : "Today tab, first-run welcome card: line under the title. The privacy claim must stay exact. About 115 characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich deine Gedanken aus. Jedes Wort wird zu einem Stern an deinem inneren Himmel. Die gesamte KI läuft auf deinem Gerät – privat von Grund auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di lo que piensas. Cada palabra se convierte en una estrella de tu cielo interior. Toda la IA funciona en tu dispositivo: privada por diseño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis ce que tu penses. Chaque mot devient une étoile de ton ciel intérieur. Toute l'IA tourne sur ton appareil — privée par conception."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' ciò che pensi. Ogni parola diventa una stella del tuo cielo interiore. Tutta l'IA gira sul tuo dispositivo: privata per progetto."
          }
        }
      }
    },
    "Speaking... tap when you're done" : {
      "comment" : "Today tab, older layout: caption while recording. About 32 characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sprichst... tippe, wenn du fertig bist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hablando... toca cuando termines"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu parles... touche quand tu as fini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai parlando... tocca quando hai finito"
          }
        }
      }
    },
    "Speech is transcribed by this iPhone; no recording and no transcript is ever sent to DailyVox, because there is no DailyVox server to send it to. Permissions used: microphone, speech, notifications." : {
      "comment" : "Settings > Data Shield: section footer, first part. A second sentence about iCloud follows after a space. Every privacy claim must stay exact."
