    "Stars, no words. The sky is the only journal artifact that is beautiful and private at the same time." : {
      "comment" : "Share sheet, the card picker: one-line description under the My Sky card's name. Up to two lines.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sterne, keine Worte. Der Himmel ist das einzige Tagebuch-Artefakt, das zugleich schön und privat ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estrellas, sin palabras. El cielo es el único recuerdo del diario que es bonito y privado a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Des étoiles, pas de mots. Le ciel est la seule trace de journal à la fois belle et privée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stelle, niente parole. Il cielo è l'unico frammento di diario bello e privato allo stesso tempo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estrelas, sem palavras. O céu é o único artefato de diário que é bonito e privado ao mesmo tempo."
          }
        }
      }
    },
    "Start on the Speak tab, below" : {
