    "The one you made today, in the sky it landed in. A new place every night — no words on it, ever." : {
      "comment" : "Share sheet, the card picker: one-line description under the Tonight card's name. Up to two lines.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Stern von heute, an dem Himmel, an dem er gelandet ist. Jede Nacht ein neuer Platz – nie mit Worten darauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La que hiciste hoy, en el cielo donde cayó. Un lugar nuevo cada noche, y nunca con palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'étoile du jour, dans le ciel où elle s'est posée. Un nouvel endroit chaque nuit — jamais aucun mot dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quella creata oggi, nel cielo in cui è arrivata. Un posto nuovo ogni notte, e mai nessuna parola sopra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A estrela que você criou hoje, no céu onde ela caiu. Um lugar novo toda noite — nunca com palavras."
          }
        }
      }
    },
