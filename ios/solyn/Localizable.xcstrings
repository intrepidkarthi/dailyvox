    "Your thoughts are yours alone. iCloud Sync is off, so nothing leaves this device." : {
      "comment" : "Settings > Privacy & Security: section footer while iCloud Sync is off. 'iCloud Sync' is the name of the setting above.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Gedanken gehören nur dir. iCloud-Sync ist aus, also verlässt nichts dieses Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus pensamientos son solo tuyos. La sincronización con iCloud está desactivada, así que nada sale de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tes pensées n'appartiennent qu'à toi. La synchronisation iCloud est désactivée : rien ne quitte cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I tuoi pensieri sono solo tuoi. La Sincronizzazione iCloud è disattivata, quindi nulla lascia questo dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seus pensamentos são só seus. A Sincronização do iCloud está desligada, então nada sai deste aparelho."
          }
        }
      }
    },
    "Your thoughts are yours alone. iCloud Sync is on, so they are copied to your own iCloud account, encrypted with your Apple ID." : {
      "comment" : "Settings > Privacy & Security: section footer while iCloud Sync is on. 'iCloud Sync' is the name of the setting above; 'Apple ID' is Apple's term in the target language.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Gedanken gehören nur dir. iCloud-Sync ist an, also werden sie in deinen eigenen iCloud-Account kopiert, verschlüsselt mit deiner Apple-ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus pensamientos son solo tuyos. La sincronización con iCloud está activada, así que se copian en tu propia cuenta de iCloud, cifrados con tu Apple ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tes pensées n'appartiennent qu'à toi. La synchronisation iCloud est activée : elles sont copiées sur ton propre compte iCloud, chiffrées avec ton compte Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I tuoi pensieri sono solo tuoi. La Sincronizzazione iCloud è attiva, quindi vengono copiati nel tuo account iCloud, crittografati con il tuo Apple ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seus pensamentos são só seus. A Sincronização do iCloud está ligada, então eles são copiados para sua própria conta do iCloud, criptografados com sua Conta Apple."
          }
        }
      }
    },
    "Your Twin can learn what your body felt" : {
      "comment" : "Body Twin invite: title on the Today card and at the top of the invite sheet. About 40 characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Twin kann lernen, was dein Körper gefühlt hat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Gemelo puede aprender lo que sintió tu cuerpo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Jumeau peut apprendre ce que ton corps a ressenti"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Gemello può imparare cosa ha sentito il tuo corpo"
