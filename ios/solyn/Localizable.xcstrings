    "Not enough yet. Patterns appear once there is enough to be sure one is real rather than a coincidence." : {
      "comment" : "Insights: shown under 'Your Twin noticed' when no pattern has passed its gates.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Noch nicht genug. Muster erscheinen, sobald genug da ist, um sicher zu sein, dass eines echt ist und kein Zufall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aún no hay suficiente. Los patrones aparecen cuando hay datos suficientes para tener la certeza de que son reales y no una casualidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pas encore assez. Les motifs apparaissent quand il y a de quoi être sûr qu'il s'agit d'un vrai motif, pas d'une coïncidence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non ancora abbastanza. Gli schemi compaiono quando ce n'è abbastanza per essere sicuri che siano reali e non una coincidenza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
