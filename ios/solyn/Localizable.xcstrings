    "Answer honestly about yourself. Then see what your Twin — built only from your entries — guessed about you." : {
      "comment" : "Twin Resolution sheet: intro above the questions. About 110 characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworte ehrlich über dich selbst. Sieh dann, was dein Twin – allein aus deinen Einträgen entstanden – über dich vermutet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde con sinceridad sobre ti. Luego mira qué adivinó tu Gemelo, construido solo a partir de tus entradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponds honnêtement à propos de toi. Puis découvre ce que ton Jumeau — bâti uniquement à partir de tes entrées — a deviné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi sinceramente su di te. Poi scopri cosa ha intuito il tuo Gemello, costruito solo dalle tue voci."
          }
        }
      }
    },
