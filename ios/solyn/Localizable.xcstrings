    "You haven't recorded anything today yet. Would you like to add an entry?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast heute noch nichts aufgenommen. Möchtest du einen Eintrag hinzufügen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has grabado nada hoy. ¿Quieres añadir una entrada?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu n'as encore rien enregistré aujourd'hui. Veux-tu ajouter une entrée ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi non hai ancora registrato nulla. Vuoi aggiungere una voce?"
          }
        }
      }
    },
    "You've asked all the questions! Tap any to ask again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast alle Fragen gestellt! Tippe eine an, um sie erneut zu stellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Has hecho todas las preguntas! Toca cualquiera para volver a preguntar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as posé toutes les questions ! Touche l'une d'elles pour la reposer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai fatto tutte le domande! Toccane una per chiederla di nuovo."
          }
        }
      }
    },
    "You've journaled for %lld consecutive days. Your dedication to self-reflection is paying off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du schreibst seit %lld Tagen in Folge. Deine Hingabe an die Selbstreflexion zahlt sich aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llevas %lld días seguidos escribiendo. Tu dedicación a la autorreflexión está dando frutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu écris depuis %lld jours d'affilée. Ton engagement dans l'introspection porte ses fruits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi da %lld giorni consecutivi. La tua dedizione all'introspezione sta dando frutti."
          }
        }
      }
    },
    "Your body had a say" : {
