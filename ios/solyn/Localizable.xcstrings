      }
    },
    "%@ entries" : {
      "comment" : "PDF journal export (from Settings), cover page: small centred line near the bottom; the placeholder is how many entries the PDF holds (0 or 2 or more). It arrives as digits in a string placeholder, exactly as the English has always printed it (never grouped), so the catalog cannot vary it by count: phrase it so one form reads right for every count.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Einträge"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entradas: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entrées : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ voci"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Registros: %@"
          }
        }
      }
    },
    "Entries mentioning them average %@ against your %@ overall, across %@ of them." : {
      "comment" : "Twin tab, Patterns: smaller line under the finding, giving the numbers behind it. Mood scores run from -1 to +1 and arrive already formatted for the locale with a sign ('+0.21'). About 90 characters. 'them' is the person named above; keep it gender-neutral. First placeholder: the average in entries that mention them. Second: the user's overall average. Third (a string placeholder): how many entries mention them. Counts marked as string placeholders arrive as digits, exactly as the English has always printed them (never grouped), so the catalog cannot vary them by count: phrase it so one form reads right for every count.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Einträge, die diese Person erwähnen, liegen im Schnitt bei %1$@, insgesamt bei %2$@ – über %3$@ davon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Entries mentioning them average %1$@ against your %2$@ overall, across %3$@ of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las entradas que lo mencionan tienen una media de %1$@ frente a tu %2$@ general (entradas: %3$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les entrées qui mentionnent cette personne sont en moyenne à %1$@, contre %2$@ en général chez toi (entrées concernées : %3$@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le voci in cui compare hanno una media di %1$@ rispetto al tuo %2$@ complessivo (voci: %3$@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Registros que citam essa pessoa têm média %1$@, contra %2$@ no geral. Registros: %3$@."
          }
        }
      }
    },
    "Evenings read brighter." : {
      "comment" : "Twin tab, Patterns: bold first line of a finding about the user's mood. Short, about 30 characters. Entries spoken after 18:00 read brighter than those before noon.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abende wirken heller."
          }
        },
        "es" : {
