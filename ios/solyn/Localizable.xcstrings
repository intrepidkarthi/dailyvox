    "Minted once, at nights 42, 100 and 365. You cannot buy it or rush it — you can only have spoken that many times." : {
      "comment" : "Share sheet, the card picker: one-line description under the Milestone card's name. Up to two lines. Keep the numbers 42, 100 and 365.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geprägt nur einmal, in den Nächten 42, 100 und 365. Du kannst sie nicht kaufen oder abkürzen – nur so oft gesprochen haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se acuña una sola vez, en las noches 42, 100 y 365. No se puede comprar ni acelerar: solo llega habiendo hablado esas veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Frappée une seule fois, aux nuits 42, 100 et 365. Impossible de l'acheter ou de la presser — il faut simplement avoir parlé autant de fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coniata una sola volta, alle notti 42, 100 e 365. Non si compra e non si affretta: si ottiene solo parlando tante volte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cunhado uma única vez, nas noites 42, 100 e 365. Não dá para comprar nem apressar — só dá para ter falado tantas vezes."
          }
        }
      }
    },
