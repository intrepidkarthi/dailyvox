        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada uma feita com a minha voz, no meu celular."
          }
        }
      }
    },
    "Everything costs zero, itemised. It argues better than a feature list." : {
