    },
    "Your sky starts\nwith your voice" : {
      "comment" : "Onboarding, invite screen: large headline on two lines; keep the line break. About 16 characters per line.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Himmel beginnt\nmit deiner Stimme"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cielo empieza\ncon tu voz"
