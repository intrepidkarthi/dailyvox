    "Arousal" : {
      "comment" : "Twin tab > Emotions: label under a ring meter, how energetic entries are (psychology sense). One word, about 10 characters."
    },
    "Ask" : {
      "comment" : "Tab bar: ask your Twin a question. One short word, about 8 characters."
    },
    "Ask about this" : {
      "comment" : "Entry detail: button that opens Ask Your Twin with a question about this entry. About 16 characters."
    },
    "Ask in your own words and I'll surface the closest entries from your journal, or tap a question below. Everything stays on this iPhone." : {
      "comment" : "Ask Your Twin screen: empty-state text in classic mode (no Apple Intelligence), in the Twin's voice. The privacy claim must stay exact. About 135 characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag mit deinen eigenen Worten, und ich hole die passendsten Einträge aus deinem Tagebuch – oder tippe unten auf eine Frage. Alles bleibt auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta con tus propias palabras y sacaré a la luz las entradas más cercanas de tu diario, o toca una pregunta de abajo. Todo se queda en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose ta question avec tes mots et je ferai remonter les entrées les plus proches de ton journal, ou touche une question ci-dessous. Tout reste sur cet iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi con parole tue e farò emergere le voci più vicine del tuo diario, oppure tocca una domanda qui sotto. Tutto resta su questo iPhone."
          }
        }
      }
    },
    "Ask in your own words, or tap a question below. Answers come from your entries, on this device — and show which entries they drew from." : {
      "comment" : "Ask Your Twin screen: empty-state text when Apple Intelligence is on. The privacy claim must stay exact. About 135 characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag mit deinen eigenen Worten oder tippe unten auf eine Frage. Die Antworten stammen aus deinen Einträgen, auf diesem Gerät – und zeigen, welche sie herangezogen haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta con tus propias palabras o toca una pregunta de abajo. Las respuestas salen de tus entradas, en este dispositivo, y muestran de cuáles partieron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose ta question avec tes mots, ou touche une question ci-dessous. Les réponses viennent de tes entrées, sur cet appareil — et indiquent lesquelles elles ont utilisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi con parole tue, oppure tocca una domanda qui sotto. Le risposte vengono dalle tue voci, su questo dispositivo, e mostrano da quali hanno attinto."
          }
        }
      }
    },
