        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Graba una entrada en la pestaña Hablar. 42 segundos es lo ideal; tómate todo el tiempo que necesites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dis une entrée dans l'onglet Parler. 42 secondes, c'est l'idéal — prends tout le temps qu'il te faut."
