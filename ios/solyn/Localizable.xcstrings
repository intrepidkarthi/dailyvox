    "Password-protected backup, including your Body Twin's health data — the only export that carries it." : {
      "comment" : "Export Data screen: line under 'Encrypted Backup'. Body Twin is the feature's name. The privacy claim must stay exact: this is the only export with health data. About 100 characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passwortgeschütztes Backup, inklusive der Gesundheitsdaten deines Body Twin – der einzige Export, der sie enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copia protegida con contraseña, que incluye los datos de salud de tu Gemelo corporal: la única exportación que los lleva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sauvegarde protégée par mot de passe, avec les données de santé de ton Jumeau corporel — le seul export qui les contient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Backup protetto da password, con i dati di salute del tuo Gemello corporeo: l'unica esportazione che li include."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Backup protegido por senha, incluindo os dados de saúde do seu Body Twin — a única exportação que os inclui."
          }
        }
      }
    },
