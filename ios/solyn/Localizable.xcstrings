    "Your constellation has begun. Every entry adds a new star to your inner sky." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Sternbild hat begonnen. Jeder Eintrag fügt deinem inneren Himmel einen neuen Stern hinzu."
