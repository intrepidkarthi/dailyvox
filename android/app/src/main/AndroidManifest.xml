<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The permission ledger the onboarding shows verbatim: microphone is
         REQUIRED, Health Connect is OPTIONAL, and INTERNET is NOT REQUESTED.
         The absence of an INTERNET permission is the product claim, in the one
         place a user can verify it without trusting us. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notifications are runtime-requested on API 33+; the daily reminder is the
         only thing that posts one, and it is off until the user turns it on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permission, granted at install. Declaring it is not optional:
         Vibrator.vibrate throws SecurityException without it, which took down
         the whole app on the first haptic. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- androidx.biometric merges USE_FINGERPRINT in for API 27 and under.
         At minSdk 33 it is dead weight, and it is not free: the listing invites
         people to read this app's permissions in app info, so a line that does
         nothing costs more here than the byte it takes. USE_BIOMETRIC, which
         BiometricPrompt actually uses, still merges in. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <!-- Health Connect, OPTIONAL and read-only, exactly as the onboarding ledger
         says. Declared is not held: nothing is requested until the user turns
         Body signals on, and only these four are ever asked for — the four the
         Twin actually correlates against. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <!-- On API 33 Health Connect is a separate APK, and package visibility
         filtering hides it: without this the availability check reports NOT
         INSTALLED on a phone that has it, and Body signals look unsupported.
         From API 34 it is part of the platform and this is simply ignored. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Auto Backup is OFF. See res/xml/data_extraction_rules.xml: the default
         (true) would have shipped the journal and the raw audio to Google Drive
         without the app holding a single network permission. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:name=".DailyVoxApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyVox">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.DailyVox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect requires a rationale target, or the permission
                 screen shows the app with no explanation of why it wants this. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- Must live INSIDE the launcher activity: the framework reads
                 shortcuts off the activity that declares MAIN/LAUNCHER, and at
                 <application> level it is silently ignored. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- The API 34+ half of the same rationale. Android 14 moved Health
             Connect into the platform and stopped reading the intent-filter
             above: it looks for VIEW_PERMISSION_USAGE with the
             HEALTH_PERMISSIONS category instead, and an app that declares only
             one of the two shows a permission screen with no explanation of
             why it wants sleep and heart rate. Play's health-data review
             checks for it. -->
        <activity-alias
            android:name=".HealthRationaleActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".system.RecordingLive$FinishReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dailyvox.app.FINISH_RECORDING" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".system.Reminders$ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".system.StarWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_star_info" />
        </receiver>

        <!-- The 4x2 variant (FINAL-SPEC §5). Its own provider because the two
             sizes show different things: 2x2 is a star, 4x2 is the strip. -->
        <receiver
            android:name=".system.WideStarWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_star_wide_info" />
        </receiver>

        <service
            android:name=".system.SpeakTile"
            android:exported="true"
            android:icon="@drawable/ic_nav_speak"
            android:label="DailyVox"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
