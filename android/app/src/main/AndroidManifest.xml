<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The permission ledger the onboarding shows verbatim: microphone is
         REQUIRED, and INTERNET is NOT REQUESTED.
         The absence of an INTERNET permission is the product claim, in the one
         place a user can verify it without trusting us. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notifications are runtime-requested on API 33+; two things post one:
         the daily reminder (on by default, one switch in Settings) and the
         ongoing chip while a recording is in progress. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permission, granted at install. Declaring it is not optional:
         Vibrator.vibrate throws SecurityException without it, which took down
         the whole app on the first haptic. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- androidx.biometric merges USE_FINGERPRINT in for API 27 and under.
         At minSdk 33 it is dead weight, and it is not free: the listing invites
         people to read this app's permissions in app info, so a line that does
         nothing costs more here than the byte it takes. USE_BIOMETRIC, which
         BiometricPrompt actually uses, still merges in. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <!-- No Health Connect in v1.0. Body signals had no screen that asked for
         access, so the two health permissions were declared and unreachable;
         and declaring them alone puts an app in Play's health-apps review.
         BodySignals.kt stays; wire a real opt-in before re-adding them. -->

    <queries>
        <!-- The speech recogniser. Package visibility filtering (Android 11+)
             hides every app this one has not declared an interest in, and a
             RecognitionService is just another app: without this the platform
             can report no recogniser on a phone that has one, and the Speak
             button fails with "no offline speech pack" on hardware where the
             pack is installed and working. Nothing in the app's own manifest
             said it wanted to talk to one. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Auto Backup is OFF. See res/xml/data_extraction_rules.xml: the default
         (true) would have shipped the journal and the raw audio to Google Drive
         without the app holding a single network permission. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:name=".DailyVoxApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyVox">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.DailyVox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>


            <!-- Must live INSIDE the launcher activity: the framework reads
                 shortcuts off the activity that declares MAIN/LAUNCHER, and at
                 <application> level it is silently ignored. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".system.RecordingLive$FinishReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dailyvox.app.FINISH_RECORDING" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".system.Reminders$ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".system.StarWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_star_info" />
        </receiver>

        <!-- The 4x2 variant (FINAL-SPEC §5). Its own provider because the two
             sizes show different things: 2x2 is a star, 4x2 is the strip. -->
        <receiver
            android:name=".system.WideStarWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_star_wide_info" />
        </receiver>

        <service
            android:name=".system.SpeakTile"
            android:exported="true"
            android:icon="@drawable/ic_nav_speak"
            android:label="DailyVox"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
