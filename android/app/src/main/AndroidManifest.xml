<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The permission ledger the onboarding shows verbatim: microphone is
         REQUIRED, Health Connect is OPTIONAL, and INTERNET is NOT REQUESTED.
         The absence of an INTERNET permission is the product claim, in the one
         place a user can verify it without trusting us. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notifications are runtime-requested on API 33+; the daily reminder is the
         only thing that posts one, and it is off until the user turns it on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permission, granted at install. Declaring it is not optional:
         Vibrator.vibrate throws SecurityException without it, which took down
         the whole app on the first haptic. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".DailyVoxApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyVox">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.DailyVox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".system.Reminders$ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".system.StarWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_star_info" />
        </receiver>

        <service
            android:name=".system.SpeakTile"
            android:exported="true"
            android:icon="@drawable/ic_nav_speak"
            android:label="DailyVox"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
