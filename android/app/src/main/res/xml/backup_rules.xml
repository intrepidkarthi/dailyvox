<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-API-31 fallback. allowBackup="false" already disables Auto Backup on these
  releases; this file exists so the policy is explicit rather than implied by an
  attribute, for anyone auditing the app.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
