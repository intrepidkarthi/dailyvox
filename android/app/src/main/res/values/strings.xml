<resources>
    <string name="app_name">DailyVox</string>
    <string name="widget_description">Tonight&#8217;s star, and the last seven nights. Never shows what you wrote.</string>
    <string name="shortcut_speak_short">Speak</string>
    <string name="shortcut_speak_long">Record tonight\'s entry</string>
    <string name="shortcut_journal_short">Journal</string>
    <string name="shortcut_journal_long">Open my journal</string>
    <string name="shortcut_ask_short">Ask Twin</string>
    <string name="shortcut_ask_long">Ask your Twin about your journal</string>

    <!-- The daily reminder. No streak guilt, and the welcome-back never says
         how long it has been. -->
    <string name="reminder_title">Tonight\'s star is waiting</string>
    <string name="reminder_text">Whenever you\'re ready. Forty-two seconds.</string>
    <string name="reminder_welcome_back_title">Your sky kept your place</string>
    <string name="reminder_welcome_back_text">No catching up to do. One sentence is plenty, whenever you\'re ready.</string>

    <!-- The reflection card on Speak, after an entry is saved. Every line is
         built from the entry itself; a line with nothing under it is not shown. -->
    <string name="reflection_label">Filed to your sky</string>
    <plurals name="reflection_words">
        <item quantity="one">%d word</item>
        <item quantity="other">%d words</item>
    </plurals>
    <string name="reflection_typed">typed</string>
    <string name="reflection_wordless">Your voice is saved. The words can come later.</string>
    <string name="reflection_tone_light">Your words lean light.</string>
    <string name="reflection_tone_even">Your words sit fairly even.</string>
    <string name="reflection_tone_heavy">Your words carry some weight. That is allowed here.</string>
    <string name="reflection_drift_lighter">Lighter than your last few entries.</string>
    <string name="reflection_drift_heavier">Heavier than your last few entries.</string>
    <string name="reflection_drift_similar">Close to how your last few entries read.</string>
    <string name="reflection_person">%1$s is in this one.</string>
    <plurals name="reflection_person_earlier">
        <item quantity="one">%1$s is in this one, and in %2$d other entry in the last 30 days.</item>
        <item quantity="other">%1$s is in this one, and in %2$d other entries in the last 30 days.</item>
    </plurals>
    <string name="reflection_tomorrow_label">For tomorrow, in your words</string>
    <string name="reflection_tomorrow_quote">“%1$s”</string>
    <string name="reflection_done">Done</string>
    <string name="reflection_done_description">Close the reflection</string>
    <string name="reflection_how_read">Read on this phone from your words. Nothing was sent anywhere.</string>

    <!-- The suggested mood. Always called a suggestion until the user taps it:
         the app read the words, it did not ask how they felt. -->
    <string name="reflection_mood_heading_suggested">Suggested mood</string>
    <string name="reflection_mood_heading_mine">Your mood</string>
    <string name="reflection_mood_suggested_body">%1$s, going by how your words read. Tap it to keep it, or pick another.</string>
    <string name="reflection_mood_suggested_line">Suggested mood: %1$s. Only a suggestion, from your words.</string>
    <string name="reflection_mood_chosen_body">%1$s. Your choice.</string>
    <string name="reflection_mood_none">None. Pick one if you like.</string>
    <string name="reflection_mood_clear">Clear</string>
    <string name="reflection_mood_clear_suggested_description">Clear the suggested mood</string>
    <string name="reflection_mood_clear_description">Clear your mood</string>

    <!-- The mood picker's chips, on the entry page and the reflection card. -->
    <string name="mood_chip_suggested">%1$s · suggested</string>
    <!-- TalkBack: state is read after the word, the action after "Double-tap to". -->
    <string name="mood_chip_state_suggested">Suggested from your words, not chosen</string>
    <string name="mood_chip_state_chosen">Your mood</string>
    <string name="mood_chip_action_choose">choose</string>
    <string name="mood_chip_action_keep">keep this mood</string>
    <string name="mood_chip_action_clear">clear</string>

    <!-- Onboarding, under the first entry. The entry is saved a moment later
         with this same suggestion, and the card that follows lets it change. -->
    <string name="onboarding_suggested_mood">Reads like %1$s. Only a suggestion: you can change it in a moment.</string>
    <!-- Your past, brought back. Every quote is the entry's own words, cut
         only at a sentence or word; nothing here is paraphrased. -->
    <string name="past_week_ago">A week ago you said</string>
    <plurals name="past_days_ago">
        <item quantity="one">A day ago you said</item>
        <item quantity="other">%1$d days ago you said</item>
    </plurals>
    <plurals name="past_months_ago">
        <item quantity="one">On this day, a month ago</item>
        <item quantity="other">On this day, %1$d months ago</item>
    </plurals>
    <plurals name="past_years_ago">
        <item quantity="one">On this day, a year ago</item>
        <item quantity="other">On this day, %1$d years ago</item>
    </plurals>
    <string name="past_quote">“%1$s”</string>
    <!-- TalkBack: the label, the quote, then what a tap does. -->
    <string name="past_card_description">%1$s: %2$s. Opens the entry.</string>

    <string name="recap_label">Your week</string>
    <string name="recap_range">%1$s – %2$s</string>
    <plurals name="recap_entries">
        <item quantity="one">%1$d entry</item>
        <item quantity="other">%1$d entries</item>
    </plurals>
    <plurals name="recap_days">
        <item quantity="one">on %1$d day</item>
        <item quantity="other">on %1$d days</item>
    </plurals>
    <plurals name="recap_name">
        <item quantity="one">%1$s came up in %2$d entry.</item>
        <item quantity="other">%1$s came up in %2$d entries.</item>
    </plurals>
    <string name="recap_line_label">One line from the week</string>
    <string name="recap_line_description">One line from the week: %1$s. Opens the entry.</string>
    <string name="recap_how_counted">Counted from your entries on this phone.</string>

    <!-- The reminder, when the user has opted in to a quote. Off by default:
         a notification can be read on a locked phone. -->
    <string name="reminder_past_text">A week ago you said: “%1$s”</string>
    <string name="settings_reminder_quote">Include a line from your past in reminders</string>
    <string name="settings_reminder_quote_note">Off by default. When on, tonight\'s reminder can quote what you said a week ago, and anyone who can see your lock screen can read it.</string>
</resources>
